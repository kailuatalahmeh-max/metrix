# Copy this file to ".env" and change the values if needed.

# PostgreSQL connection. These values match docker-compose.yml.
DATABASE_URL="postgresql://metrix:metrix@localhost:5432/metrix?schema=public"

# Port for the NestJS API.
PORT=3001

# The address of the Next.js website (for CORS).
WEB_URL="http://localhost:3000"
